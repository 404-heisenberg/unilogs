# Copy to .env.test and fill in. This backs the disposable Postgres that
# `npm run test:db:up` starts from docker-compose.test.yml.
#
# vitest.config.ts refuses to run unless TEST_DATABASE_URL is set, is a valid
# PostgreSQL URL, and contains "test" in the database name — so a typo here
# fails loudly instead of wiping a real database.

NODE_ENV=test
TEST_DATABASE_URL=postgresql://unilogs_test:unilogs_test@localhost:5433/unilogs_test
BETTER_AUTH_SECRET=local-test-secret-at-least-thirty-two-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
