# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every value below is blank unless the code has a usable local default.

# --- Required -------------------------------------------------------------

# Neon development branch. Used by Prisma directly, with no fallback.
DATABASE_URL=

# Signs session cookies. Use at least 32 characters; better-auth warns about
# short secrets in production.
BETTER_AUTH_SECRET=

# --- Optional: defaults suit local development ----------------------------

PORT=3000
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000

# --- Optional: Google sign-in ---------------------------------------------
# Leave both blank to hide the Google option. Create credentials in the Google
# Cloud console and add the redirect URI your BETTER_AUTH_URL implies.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: email delivery ---------------------------------------------
# Without these, sendEmail logs "[email not sent - SendGrid not configured]"
# and returns false instead of sending. Note that outside production a failed
# send makes /api/auth/forgot-password return the reset link in its response
# body so the flow stays testable without an inbox — never do that in production.

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Optional: assorted ----------------------------------------------------

# Origin for shareable report links. Falls back to CORS_ORIGIN.
SHARE_BASE_URL=

# Connection pool size. Defaults to 10.
DATABASE_POOL_MAX=
